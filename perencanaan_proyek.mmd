%% =========================================================================
%% DIAGRAM 3: USE CASE DIAGRAM (INTERAKSI USER & SISTEM)
%% =========================================================================
usecaseDiagram
    actor Masyarakat
    actor Petugas
    actor Admin
    
    Masyarakat --> (Registrasi / Login NIK)
    Masyarakat --> (Buat Laporan Pengaduan)
    Masyarakat --> (Lacak Status Laporan)
    
    Petugas --> (Verifikasi Laporan Masuk)
    Petugas --> (Ubah Status & Beri Tanggapan)
    
    Admin --> (Manajemen User & Role)
    Admin --> (Lihat Dashboard Statistik)
    Admin --> (Export Laporan PDF/Excel)


%% =========================================================================
%% DIAGRAM 4: ARSITEKTUR SOLUSI (FLOWCHART MVC)
%% =========================================================================
graph TD
    Client[Browser HP/Laptop Warga] -->|HTTP/HTTPS Akses| WebServer[Nginx/Apache Server]
    WebServer --> Laravel[Aplikasi Laravel 12]
    
    subgraph Pola Arsitektur MVC
        Laravel --> Controllers[Controllers - Business Logic]
        Controllers --> Models[Eloquent ORM Models]
        Models <--> Database[(MySQL Database)]
        Controllers --> Views[Blade Templates + Bootstrap 5]
    end
    
    Views -->|Render HTML/CSS/JS| Client
